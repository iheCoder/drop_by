# config.yaml 中省略的字段可由这些环境变量补齐。
DROPBY_ADDR=127.0.0.1:8090
DROPBY_DATA_DIR=data
# 默认读取工作目录的 config.yaml，也可以指定文件路径。
# DROPBY_CONFIG=/path/to/config.yaml
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DROPBY_SEARCH_KEY=
DROPBY_SEARCH_URL=https://api.deepseek.com/v1/tools

# 每周一 00:00 按服务进程本地时区恢复预算；这台机器使用上海时区。
TZ=Asia/Shanghai
# 开发运行边界。费用按各模型 Standard 费率估算，不等于服务商账单。
DROPBY_WEEKLY_BUDGET_USD=20
# 自主与真人工作共用总预算，不再设置隐藏子额度或调用次数配额。
DROPBY_EXPLORE_INTERVAL=30m

# 可选：显式代理优先；留空时 macOS 自动跟随当前系统代理。
# HTTPS_PROXY=http://your-proxy-host:port
# NO_PROXY=localhost,127.0.0.1,::1

# 可选的一次性开发额度；到期自动回到通常周预算，不清零账目
# DROPBY_TEMPORARY_BUDGET_USD=30
# DROPBY_TEMPORARY_BUDGET_UNTIL=2026-11-09T00:00:00+08:00
