# 不把真实密钥写进仓库。程序直接读取启动进程的环境。
# 已有 OPENAI_API_KEY 时不必重复设置 DROPBY_API_KEY。
DROPBY_ADDR=127.0.0.1:8090
DROPBY_DATA_DIR=data
DROPBY_BASE_URL=https://api.openai.com/v1
# 主模型用于实际研究、控制理解与真实性核对。
DROPBY_MODEL=gpt-6.1-sol
DROPBY_DECISION_MODEL=gpt-6-luna
DROPBY_CHAT_MODEL=gpt-6.1-terra
# OPENAI_API_KEY=
# DROPBY_API_KEY=
# DEEPSEEK_API_KEY=
# DROPBY_SEARCH_KEY=
DROPBY_SEARCH_URL=https://api.deepseek.com/v1/tools

# 每周一 00:00 按服务进程本地时区恢复预算；这台机器使用上海时区。
TZ=Asia/Shanghai
# 开发运行边界。费用按配置费率估算，不等于服务商账单。
DROPBY_WEEKLY_BUDGET_USD=20
# 自主后台额度包含在总预算内；保留空间给真人聊天和明确工作。
DROPBY_AUTONOMOUS_WEEKLY_BUDGET_USD=7
DROPBY_WEEKLY_CALLS=4200
DROPBY_INPUT_PRICE=4
DROPBY_OUTPUT_PRICE=20
DROPBY_MAX_TURNS=5
DROPBY_MAX_TOOL_ROUNDS=8
DROPBY_MAX_OUTPUT_TOKENS=8000
DROPBY_DEEP_MAX_OUTPUT_TOKENS=25000
# 输入使用包含工具定义的保守 token 上界；总额中同时留出本次输出空间。
DROPBY_CONTEXT_TOKEN_BUDGET=100000
DROPBY_REASONING=low
DROPBY_DEEP_REASONING=high
DROPBY_EXPLORE_INTERVAL=30m

# 本机若依赖系统代理，Go 需显式设置（地址以本机配置为准）。
# HTTPS_PROXY=http://127.0.0.1:7790
# NO_PROXY=localhost,127.0.0.1,::1
